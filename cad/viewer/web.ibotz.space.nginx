# Static pages from zen4 (the arm viewer at /roboruka/) behind the *.ibotz.space login, on ibotz2.
# Same pattern as mon.ibotz.space: zen4 over the VPN tunnel (10.9.0.6), a static nginx container
# (web-static, port 8091, serves ~/www) - see cad/viewer/deploy_web.sh. Access via
# snippets/llm-auth.conf (trusted IP, Bearer token or Google session).
#
# Install on ibotz2:
#   sudo install -m 644 web.ibotz.space /etc/nginx/sites-available/web.ibotz.space
#   sudo ln -sf ../sites-available/web.ibotz.space /etc/nginx/sites-enabled/web.ibotz.space
#   sudo nginx -t && sudo systemctl reload nginx
# DNS: A record web.ibotz.space -> 62.84.190.161 (DNS only, like mon/ai/gpt/sd).

upstream zen4_web { server 10.9.0.6:8091; keepalive 4; }

server {
    listen 80;
    listen [::]:80;
    server_name web.ibotz.space;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name web.ibotz.space;
    ssl_certificate     /etc/letsencrypt/live/ibotz.space/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ibotz.space/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    error_log  /var/log/nginx/web.ibotz.space.error.log;
    access_log /var/log/nginx/web.ibotz.space.access.log;
    include snippets/llm-auth.conf;

    location = / { return 302 /roboruka/; }
    location / {
        limit_req zone=llm_api burst=50 nodelay;
        proxy_pass http://zen4_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        gzip on;
        gzip_types application/javascript text/css;   # text/html is always on
    }
}
